{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // For scripts/*.mjs: each carries `// @ts-check`, and the tests import collection-feed.mjs (which has
    // no declarations) — without allowJs the typecheck fails on TS7016.
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  // Type-check ONLY config (noEmit) over src, the Node scripts and the tests — the single typecheck
  // gate. The scripts are the one piece of code whose failure breaks a deploy, which is why they are in
  // here (with @types/node) rather than left to run-and-see.
  "include": ["src/**/*.ts", "scripts/**/*.mjs", "test/**/*.ts"]
}
