{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // The browser program: no Node globals. @types/node is installed for the scripts and the tests
    // (tsconfig.node.json), and without this an installed @types package is pulled into every program —
    // `process` in src/ would type-check and only fail in the browser.
    "types": []
  },
  // Type-check ONLY config (noEmit) over the site itself. The Node scripts and the tests are checked by
  // tsconfig.node.json, which extends this one — `npm run typecheck` runs both.
  "include": ["src/**/*.ts"]
}
